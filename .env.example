MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/MashawerrDB?retryWrites=true&w=majority
PORT=3000
NODE_ENV=development

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_jwt_access_secret_64_bytes
JWT_REFRESH_SECRET=your_jwt_refresh_secret_64_bytes
JWT_ACCESS_EXPIRES=10m
JWT_REFRESH_EXPIRES=120d
JWT_SECRET=your_legacy_jwt_secret

# ─── Email & Branding ────────────────────────────────────────────────────────
USER_EMAIL=youremail@example.com
USER_PASS=your_email_app_password
CLINIC_NAME=Mashawerr
PRICING_API_KEY=your_pricing_api_key
ADMIN_KEY=your_admin_secret_key

# ─── Server URL (Render / Production) ─────────────────────────────────────────
# HOST=https://mashawerr-api.onrender.com
# RENDER_EXTERNAL_URL=https://mashawerr-api.onrender.com

# ─── Cloudinary (Image Storage) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Google Routes API & Ride Tracking ───────────────────────────────────────
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key
REDIS_URL=redis://localhost:6379
OFF_ROUTE_THRESHOLD_M=50
ROUTE_COOLDOWN_MS=20000
LOG_LEVEL=debug
MIN_MOVE_METERS=15
BROADCAST_THROTTLE_MS=1000
REDIS_WRITE_DEBOUNCE_MS=1500
SEND_LOCATION_ACK=false
DEBUG_NAVIGATION=true

# ─── Route Pipeline v3 (Mashawerr Cost Reduction & Prefetching) ──────────────
ROUTE_CACHE_GEOHASH_PRECISION=7
ROUTE_CACHE_GEOMETRY_TTL_SEC=3600
ROUTE_CACHE_TRAFFIC_TTL_SEC=300
ACTIVE_ROUTE_CACHE_TTL_SEC=7200
MEMORY_ROUTE_CACHE_MAX_ITEMS=500
MEMORY_ROUTE_CACHE_TTL_MS=120000
ROUTE_CACHE_ORIGIN_GEOHASH_PRECISION=9
ORIGIN_DRIFT_CACHE_MAX_M=5
ORIGIN_DRIFT_MAX_M=20
OFF_ROUTE_THRESHOLD_M=35
OFF_ROUTE_IMMEDIATE_M=100
REROUTE_COOLDOWN_SEC=15
TRIP_START_LOCK_TTL_SEC=10
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_MS=60000
